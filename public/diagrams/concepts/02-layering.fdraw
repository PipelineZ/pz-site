title: text "How the code is layered" at 40,52 style=h1
text "Every arrow points downward. Nothing lower in the stack has ever heard of anything above it." at 40,80 style=dek

// ---- the host: one process ---------------------------------------------------------
host: zone "THE HOST · ONE PROCESS" at 40,120 1008x584 title.align=left

cli:     node "Pz.Cli" sub="the verbs you type: console output, exit codes" at 312,168 464x80
engine:  node "Pz.Engine" sub="dispatcher, node executors,\nretries, run artifacts, watermarks" at 312,312 224x80
pm:      node "Pz.PackageManagement" sub="NuGet resolution, pz.lock.json,\nthe connector ALC host" at 808,312 224x80
core:    node "Pz.Core" sub="YAML + SQL parsing, Scriban,\nDAG compilation, validation" at 64,456 224x80
duckdb:  node "Pz.DuckDb" sub="the only code that talks to\nDuckDB: Arrow, query, EXPLAIN" at 312,456 224x80
diag:    node "Pz.Diagnostics" sub="typed run events, tracing,\nmeters: one event stream" at 560,456 224x80
abi:     focal "Pz.Connectors.Abstractions" sub="the connector ABI: the contract the whole ecosystem is written against.\nAdditive-only: growth is new capability interfaces, never ISourceConnector2." at 312,600 720x80

cli.bottom@424 -> engine.top@424
cli.right -> pm.top
cli.left -> core.top@176
engine.bottom@384 -> core.top@216 via=384,424;216,424
engine.bottom@424 -> duckdb.top@424
engine.bottom@464 -> diag.top@632 via=464,424;632,424
pm.bottom@920 -> abi.top@920

text "Pz.Cli uses Pz.Core" at 188,372 style=caption
text "directly too" at 188,388 style=caption

// ---- plugins: each in its own load context -----------------------------------------
plugins: zone "PLUGINS · EACH IN ITS OWN AssemblyLoadContext" at 1128,120 336x440 title.align=left

conns:   optional "connectors/" sub="fifteen, in this repo:\nLocalFiles  Postgres  S3  SqlServer  AzureBlob\nGcs  Http  MySql  Sqlite  Sftp\nDuckDb  DuckLake  Quack  MotherDuck  Iceberg" at 1152,168 288x96
toolkit: optional "Pz.Connectors.Toolkit" sub="optional author helpers: codecs, auth,\npaging, transient classification" at 1152,312 288x80
testkit: optional "Pz.Connectors.TestKit" sub="the acceptance suite every connector\nmust pass against that same ABI" at 1152,456 288x80

conns -> toolkit
conns.left -> abi.right@624 via=1080,216;1080,624
toolkit.left -> abi.right@656 via=1104,352;1104,656

// ---- outside the stack ---------------------------------------------------------------
text "Also referenced directly by Pz.Cli, not loaded as connectors" at 40,744 style=eyebrow
text "Pz.Mcp" at 40,772 style=small size=11
text "the pz mcp server: typed tools an agent can call to introspect, verify and author a project" at 296,772 style=caption
text "Pz.State.Http · Pz.State.SqlServer" at 40,796 style=small size=11
text "pluggable state backends for watermarks and run artifacts" at 296,796 style=caption

text "That downward-only rule is what makes a connector a plugin instead of a fork: it compiles against the ABI and nothing else." at 40,840 style=dek

legend at 40,864 node="Host project" focal="The connector ABI everything compiles against" optional="Plugin, loaded in its own AssemblyLoadContext" arrow="Depends on"
