      "x": 94,
      "y": 496,
      "width": 625,
      "height": 69,
      "text": "SetupStatements: CREATE SECRET src_az (TYPE azure, CONNECTION_STRING '...');\nSqlFragment:                                                  -- never logged\n  CREATE TABLE staging.src_events__clicks AS\n  SELECT * FROM read_parquet('az://analytics/clicks/*.parquet');\nMechanism: \"read_parquet\"  -- shows up in pz plan reasons",
