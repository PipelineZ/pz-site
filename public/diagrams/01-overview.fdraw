title: text "PipelineZ (pz): how a run works" at 40,52 style=h1
text "dbt-inspired batch ETL CLI for .NET. YAML + SQL in, DuckDB does the heavy lifting, one process, no cluster." at 40,80 style=dek

// ---- the 10-second version ---------------------------------------------------
text "The 10-second version" at 40,124 style=eyebrow

project: node "project" sub="YAML + SQL files" at 40,136 280x64
compile: node "pz compile" sub="render SQL, build the DAG" at 384,136 280x64
run:     focal "pz run" sub="DuckDB executes the DAG" at 728,136 280x64
result:  store "data written to sinks" sub="+ run_results.json" at 1072,136 280x64

project -> compile
compile -> run
run -> result

40,236 -- 1352,236 style=rule

// ---- hub and spoke -------------------------------------------------------------
text "One process, hub and spoke: DuckDB is the hub" at 40,276 size=16 weight=600 color=ink

text "Sources" at 40,312 style=eyebrow
text "Sinks" at 1144,312 style=eyebrow

land:  zone "land" at 280,328 120x272
drain: zone "drain" at 992,328 120x272
hub:   zone "DuckDB staging DB · .pz/runs/<run_id>/staging.duckdb" at 432,328 528x272

src_sql:   external "SQL Server" sub="arrow stream (SqlClient)" at 40,352 208x64
src_files: external "Local files" sub="CSV / JSON / Parquet" at 40,432 208x64
src_az:    external "Azure Blob / ADLS" sub="az:// native scan" at 40,512 208x64

text "staging tables" at 464,372 style=eyebrow
text "pipelines (SQL)" at 736,372 style=eyebrow
t_orders:    store "src_crm__orders" at 464,384 192x56
t_customers: store "src_crm__customers" at 464,464 192x56
p_stg:       node "stg_orders" at 736,384 192x56
p_enriched:  node "orders_enriched" at 736,464 192x56

t_orders -> p_stg
p_stg -> p_enriched
t_customers -> p_enriched

text "SQL transforms run inside DuckDB: parallel and out-of-core, spilling to disk when data > memory_limit." at 464,552 style=caption
text ".NET never buffers a dataset, only in-flight batches." at 464,568 style=caption

sink_parquet: store "Parquet files" sub="out/curated/, az://..." at 1144,352 208x64
sink_csv:     store "CSV files" sub="out/totals/" at 1144,432 208x64
sink_sql:     store "SQL Server table" sub="append / replace / merge" at 1144,512 208x64

src_sql.right -> 432,384
src_files.right -> 432,464
src_az.right -> 432,544
960,384 -> sink_parquet.left
960,464 -> sink_csv.left
960,544 -> sink_sql.left

