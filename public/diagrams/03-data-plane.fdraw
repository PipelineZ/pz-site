text "future runs" at 1248,1184 style=caption anchor=middle
text "lo" at 1032,1248 style=small anchor=middle
text "hi = lo + max_window" at 1144,1248 style=small anchor=middle
text "this run: WHERE updated_at > lo AND updated_at <= hi" at 936,1276 style=caption
text "one giant backfill becomes a loop of small committed slices" at 936,1292 style=caption
1352,1324 -> 936,1324 style=return "external loop"
text "run -> watermark commits -> repeat until caught up" at 936,1348 style=caption
text "an empty slice still advances the watermark: a data gap can't stall the loop" at 936,1364 style=caption

// ---- guardrails ----
text "Guardrails around the flow" at 40,1408 size=16 weight=600 color=ink
g1: optional "retry: {max_attempts: 5, base_delay: 2s}" sub="per source/sink instance, per dataset" at 40,1424 316x56
g2: optional "max_concurrency: 2" sub="caps an instance's parallel nodes" at 372,1424 252x56
g3: optional "max_rows_per_second: 50000" sub="token-bucket pacing in the batch loop" at 640,1424 300x56
g4: optional "breaker: {failure_threshold: 5, cool_down: 2m}" sub="pause a dying instance's nodes, probe, resume" at 956,1424 396x56

legend at 40,1504 decision="Planner question" focal="Where DuckDB takes the bytes" external="Source storage" node="Connector code" store="Staging table" zone="Tier or channel" optional="Guardrail knob" swatch.amber/0.3="This run's slice" return="Backpressure / loop"
