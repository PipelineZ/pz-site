// ---- tier 2 ----
tier2: zone "Tier 2: Arrow batch stream (universal path)" at 712,304 640x496 title.align=left
r1: node "partition reader 1" at 736,368 160x48
r2: node "partition reader 2" at 736,432 160x48
chan: zone "BoundedChannel<RecordBatch>, cap 4" at 928,352 152x128 title.size=9
rect at 944,392 28x28 radius=4 fill=ink/0.18 stroke=none
rect at 980,392 28x28 radius=4 fill=ink/0.18 stroke=none
rect at 1016,392 28x28 radius=4 fill=ink/0.18 stroke=none
rect at 1052,392 28x28 radius=4 fill=none stroke=ink/0.3 dash=3,3
text "batches of ~32 MB each" at 1004,456 style=caption anchor=middle
ingest: focal "arrow_scan ingest" sub="zero-copy via the Arrow\nC Data Interface" at 1120,380 208x72
staged: store "staging.src_d365__contacts" at 1120,500 208x48
r1.right -> 928,392
r2.right -> 928,456
1080,416 -> ingest.left
ingest -> staged
1004,512 -> 904,512 style=return "backpressure"
text "channel full => readers suspend" at 908,532 style=caption
text "RatePacer throttles" at 736,500 style=caption color=muted
text "the batch loop" at 736,516 style=caption color=muted
text "windowed staging trimmed" at 1120,572 style=caption color=muted
text "to (lo, hi] post-land" at 1120,588 style=caption color=muted
text "connector code: async I/O over a REST / OData API," at 736,564 style=caption
text "1..N partition readers" at 736,580 style=caption
text "Arrow buffers live off-heap in pooled native memory: a 32 MB batch is invisible to the GC." at 736,620 style=caption
text "DuckDB reads the connector's buffers directly; no per-value marshaling anywhere." at 736,636 style=caption
text "the whole universal contract (connector ABI)" at 736,676 style=caption weight=600
rect at 736,684 288x80 radius=6 fill=ink/0.04 stroke=ink/0.12
text "PlanReadAsync(spec, hints, ct)" at 748,704 style=small
text "-> IDatasetPartition [1..N]" at 759,720 style=small
text "partition.ReadAsync(options, ct)" at 748,736 style=small
text "-> IAsyncEnumerable<RecordBatch>" at 759,752 style=small
text "channel stall metrics name the bottleneck" at 1040,676 style=caption weight=600
rect at 1040,684 288x80 radius=6 fill=ink/0.04 stroke=ink/0.12
text "orders load: source-bound -" at 1052,704 style=small
text "reader busy 92%, ingest idle 71%." at 1063,720 style=small
text "consider partitioned read" at 1063,736 style=small
text "(connector supports 8)." at 1063,752 style=small

// ---- sinks ----
text "Sinks mirror the same two tiers" at 40,844 size=16 weight=600 color=ink
text "native copy: the sink returns COPY (SELECT * FROM staging.order_totals) TO 'out/totals/' (FORMAT csv), and DuckDB writes directly." at 40,872 style=caption
text "universal: DuckDB result stream -> bounded channel -> ISinkWriteSession.WriteBatchAsync per batch, then Commit XOR Abort." at 40,888 style=caption
text "temp-write + atomic swap makes write.strategy: replace all-or-nothing: a failed run never leaves a half-replaced output." at 40,904 style=caption
40,928 -- 1352,928 style=rule

// ---- how much data per run ----
text "How much data per run? Three modes" at 40,968 size=16 weight=600 color=ink
text "Within a run, data never arrives all at once: it streams as ~32 MB Arrow batches (tier 2) or a DuckDB scan (tier 1)." at 40,992 style=caption
text "What IS configurable is how much of the dataset each run claims:" at 40,1008 style=caption
text "Full load (default)" at 40,1048 style=eyebrow
text "Incremental (watermark)" at 488,1048 style=eyebrow
text "Bounded windows" at 936,1048 style=eyebrow
rect at 40,1056 416x64 radius=6 fill=ink/0.04 stroke=ink/0.12
text "datasets:" at 52,1076 style=small
text "orders:" at 63,1092 style=small
text "table: orders" at 74,1108 style=small
