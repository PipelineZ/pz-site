warehouse.right@0.5 -> bi.left
warehouse.right@0.5 -> analysts.left
warehouse.right@0.5 -> ml.left
warehouse.right@0.5 -> other.left

// ---- two concerns that cut across everything --------------------------------------
text "Two concerns that" at 40,488 style=eyebrow
text "cut across everything" at 40,502 style=eyebrow

orchestrator: node "Orchestrator" sub="decides what runs, in what order, and when" at 312,472 560x56 stroke=amber/0.7
monitoring:   node "Monitoring & catalog" sub="is it running? is it fresh? where did this number come from?" at 40,560 1104x56 stroke=violet/0.6

