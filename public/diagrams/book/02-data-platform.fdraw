text "SQL runs inside the" at 528,164 style=caption
text "warehouse and writes" at 528,180 style=caption
text "back into it" at 528,196 style=caption
text "raw copies kept as files" at 520,336 style=caption

apps -> ingestion.left@0.5
saas -> ingestion.left@0.5
files -> ingestion.left@0.5
events -> ingestion.left@0.5

ingestion -> lake
lake -> warehouse
