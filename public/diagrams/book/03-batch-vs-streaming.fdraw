title: text "Batch and streaming" at 40,52 style=h1
text "Not two technologies - two answers to one question: how often?" at 40,80 style=dek

// time scale: x = 100 + hours since Mon 00:00 * 16.67 (06:00 Mon = 200, one day = 400px)

// ---- batch ------------------------------------------------------------------------
text "Batch - runs on a clock" at 40,128 style=eyebrow
text "each run swallows a whole day of orders in one gulp, then the machine goes quiet" at 40,144 style=caption
80,248 -- 1120,248 stroke=muted/0.45 sw=1
run1: node "one run" at 200,184 96x56
ellipse at 196,244 8x8 fill=ink stroke=none
text "06:00 Mon" at 200,272 style=small anchor=middle
run2: node "one run" at 600,184 96x56
ellipse at 596,244 8x8 fill=ink stroke=none
text "06:00 Tue" at 600,272 style=small anchor=middle
run3: node "one run" at 1000,184 96x56
ellipse at 996,244 8x8 fill=ink stroke=none
text "06:00 Wed" at 1000,272 style=small anchor=middle
text "nothing" at 448,216 style=caption anchor=middle color=muted
text "nothing" at 848,216 style=caption anchor=middle color=muted

// ---- streaming ----------------------------------------------------------------------
text "Streaming - runs always" at 40,328 style=eyebrow
text "each order is handled on its own, seconds after it is placed - and the traffic is never even" at 40,344 style=caption
