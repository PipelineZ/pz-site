      "x": 74,
      "y": 548,
      "width": 425,
      "height": 69,
      "text": "INSERT INTO {{ sink('lake', 'orders_curated') }}\nselect o.id, o.amount, c.email\nfrom {{ ref('stg_orders') }} as o\njoin {{ source('crm', 'customers') }} as c\n  on c.id = o.customer_id",
