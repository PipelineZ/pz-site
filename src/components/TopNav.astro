---
/**
 * The topbar's section nav: five flat destinations plus GitHub, no dropdown.
 *
 * Rendered twice per page — once in the header (`variant="header"`) and once inside the
 * mobile menu (`variant="mobile"`), because Starlight hides the header's right group below
 * 50rem. The mobile variant also carries the "Get Started" button, since that CTA has no
 * other home once the header's right group is hidden; GitHub doesn't need to be repeated
 * there — it already appears in the mobile menu's own footer (see MobileMenuFooter).
 */
import { Icon } from '@astrojs/starlight/components';

interface Props {
	variant: 'header' | 'mobile';
}

const { variant } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (path: string) => base + path;
/** Compare against the route, not the link, so a page nested under a section still lights
 * up its top-nav item (e.g. /book/03-… still lights up "Blog", /how-to/gcs/ lights up
 * "Guides"). The connectors concept deep-dive counts as "Connectors" even though it lives
 * under /concepts/ — content, not URL shape, decides. */
const path = Astro.url.pathname.slice(base.length) || '/';
const inGuides = path.startsWith('/guides') || path.startsWith('/how-to');
const inConnectors = path.startsWith('/connectors') || path.startsWith('/concepts/connectors');
const inBlog = path.startsWith('/book');
const inDocs = path !== '/' && !inGuides && !inConnectors && !inBlog;

const SECTIONS = [
	{ label: 'Docs', path: '/docs/', current: inDocs },
	{ label: 'Guides', path: '/guides/', current: inGuides },
	{ label: 'Connectors', path: '/connectors/', current: inConnectors },
	{ label: 'Blog', path: '/book/', current: inBlog },
];

const GITHUB_URL = 'https://github.com/PipelineZ/pz';
---

{
	variant === 'header' ? (
		<nav class="pz-nav" aria-label="Sections">
			{SECTIONS.map((section) => (
				<a class="pz-nav-item" href={href(section.path)} aria-current={section.current ? 'page' : undefined}>
					{section.label}
				</a>
			))}
			<a class="pz-nav-item pz-nav-gh" href={GITHUB_URL} rel="me">
				<Icon name="github" />
				GitHub
			</a>
		</nav>
	) : (
		<nav class="pz-nav-mobile" aria-label="Sections">
			<a class="pz-mobile-cta" href={href('/quickstart/')}>
				Get Started
				<Icon name="right-arrow" />
			</a>
			{SECTIONS.map((section) => (
				<a class="pz-mobile-section" href={href(section.path)} aria-current={section.current ? 'page' : undefined}>
					{section.label}
				</a>
			))}
		</nav>
	)
}

<style>
	/* Nav labels borrow the display face the site title already uses. */
	.pz-nav,
	.pz-nav-mobile {
		font-family: 'Bricolage Grotesque Variable', var(--sl-font-system);
	}

	.pz-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.pz-nav-item {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.7rem;
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
		transition: color 150ms ease, background-color 150ms ease;
	}
	.pz-nav-item:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}
	.pz-nav-item[aria-current] {
		color: var(--sl-color-text-accent);
	}
	.pz-nav-gh svg {
		width: 1rem;
		height: 1rem;
	}

	/* ---- Mobile menu variant ---- */
	.pz-nav-mobile {
		display: grid;
		gap: 0.5rem;
		padding-block-end: 1rem;
		margin-block-end: 0.5rem;
		border-bottom: 1px solid var(--sl-color-gray-6);
	}
	.pz-mobile-section {
		display: grid;
		gap: 0.15rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.6rem;
		font-weight: 600;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.pz-mobile-section[aria-current] {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-text-accent);
	}
	.pz-mobile-cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 0.7rem 0.75rem;
		border-radius: 0.6rem;
		background: var(--sl-color-accent);
		color: #0d0d0d;
		font-weight: 700;
		text-decoration: none;
	}
	.pz-mobile-cta svg {
		width: 1rem;
		height: 1rem;
	}
</style>
