/**
 * The homepage's "Connects to what you already use" grid: every connector the docs list, the
 * builtins (shipped inside the `pz` binary, one page each under /connectors/) first, then the
 * external `Pz.Connector.*` packages (one section each on /connectors/external/). Keep this list
 * in step with those pages when a connector is added or retired.
 *
 * Every mark is in color. Single-color marks come from Simple Icons (CC0) or, for S3, Azure Blob
 * and SQL Server, from the hero diagram's own icons; a brand whose only color is near-black (Kafka,
 * GitHub) sits on a white badge so it reads on the dark theme. Multi-color marks are inline
 * `markup`: the project's own logo (DuckLake, Iceberg, Delta Lake, MotherDuck), Devicon (MIT;
 * SQLite) or the gilbarbara "logos" set (CC0; Elasticsearch) with their near-black parts following
 * the text color, Microsoft's Azure architecture icons (Cosmos DB, Event Hubs), or a Lucide (ISC)
 * glyph in a site accent for the protocol connectors that have no brand (local files, SFTP, HTTP,
 * Quack). Markup is trusted, checked-in SVG only.
 */
interface Connector {
	name: string;
	/** Short category shown under the name, not a sentence. */
	label: string;
	/** Path under the site base, with its trailing slash or #anchor. */
	href: string;
	tier: 'builtin' | 'external';
	viewBox: string;
	/** A real hex from the brand. */
	color?: string;
	path?: string;
	/** The inner SVG elements of a multi-color mark, in place of `path`. */
	markup?: string;
	/** A circle painted behind a mark that would not read on the tile alone (DuckDB, Kafka, GitHub). */
	badge?: string;
}

