const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ul class="pz-conn-grid">
	{
		CONNECTORS.map((c) => (
			<li>
				<a class="pz-conn" href={base + c.href}>
					<span class="pz-conn-mark" style={c.badge ? `background:${c.badge}` : undefined}>
						{c.markup ? (
							<svg viewBox={c.viewBox} aria-hidden="true" set:html={c.markup} />
						) : (
							<svg viewBox={c.viewBox} aria-hidden="true">
								<path fill={c.color} d={c.path} />
							</svg>
						)}
					</span>
					<span class="pz-conn-text">
						<span class="pz-conn-name">{c.name}</span>
						<span class="pz-conn-label">
							{c.label}
							{c.tier === 'external' && <span class="pz-conn-tier"> · package</span>}
						</span>
					</span>
				</a>
			</li>
		))
	}
</ul>
