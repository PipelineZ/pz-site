---
/**
 * The "Built with open source" row on the homepage — the real runtime dependencies `pz`
 * ships with (verified against the pz repo's .csproj files, not guessed), laid out
 * horizontally as a plain, airy logo strip: circular marks, a short category label under
 * each name, spacing rather than card chrome or divider lines to keep them apart.
 *
 * Marks use each project's own real brand color where one exists (sourced from Simple
 * Icons' data, not drawn from memory) rather than the site's own accent, since these are
 * third-party logos, not PipelineZ's identity. Apache Arrow and OpenTelemetry have no
 * single defined brand color in that data, so they render neutral instead of a guessed hue.
 */
interface Project {
	name: string;
	/** Short category label shown under the name (e.g. "Analytics Engine"), not a sentence. */
	label: string;
	path: string;
	/** A real hex from the project's own brand, or "neutral" where none is defined. */
	color: string | 'neutral';
	/** DuckDB's mark is two-tone by design — the path is solid yellow with the eye and
	 * beak cut out of it (opposite-winding subpaths), so a dark circle behind it is what
	 * makes those cutouts read as black rather than showing whatever's behind the icon. No
	 * other project's mark needs this, so it's opt-in rather than a shared background. */
	badge?: string;
}

