---

<ul class="pz-oss-row-list" style={{ '--oss-count': PROJECTS.length }}>
	{
		PROJECTS.map((project) => (
			<li class="pz-oss-item">
				<span
					class:list={[
						'pz-oss-mark',
						project.color === 'neutral' && 'pz-oss-mark--neutral',
						project.badge && 'pz-oss-mark--badge',
					]}
					style={{
						...(project.color !== 'neutral' ? { '--mark': project.color } : {}),
						...(project.badge ? { background: project.badge } : {}),
					}}
				>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d={project.path} />
					</svg>
				</span>
				<span class="pz-oss-info">
					<strong>{project.name}</strong>
					<span>{project.label}</span>
				</span>
			</li>
		))
	}
</ul>

<style>
	/* Shares the row with .pz-oss-head (see landing.css's .pz-oss-strip) — grows to fill
	   whatever width the heading block doesn't take. Equal-width grid columns (rather than
	   flex's intrinsic sizing) are what make the vertical rules land at even intervals
	   regardless of how wide each name/icon naturally is; --oss-count is set inline from
	   the project list length so this doesn't need editing by hand if it changes. Below
	   30rem there isn't room for that many equal columns, so it drops to 2 and wraps —
	   a wrapped row can still start with a rule then, since flexbox/grid have no clean way
	   to detect "first in its own wrapped line" from CSS alone. */
	.pz-oss-row-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
	}
	@media (min-width: 30rem) {
		.pz-oss-row-list {
			grid-template-columns: repeat(var(--oss-count), 1fr);
		}
	}

	.pz-oss-item {
		/* Starlight's content-spacing rule (`.sl-markdown-content :not(...) +
		   :not(...)`) treats these <li>s as stacked prose and pushes every
		   one but the first down a bit, throwing off the row. */
		margin-top: 0 !important;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.6rem;
		padding: 0.5rem 1rem;
	}
	.pz-oss-item:not(:first-child) {
		border-inline-start: 1px solid var(--sl-color-gray-5);
	}
	.pz-oss-item:hover .pz-oss-mark {
		transform: translateY(-2px);
	}

	/* Bare logos, no background shape — each brand's own form and color, same as the
	   reference (only DuckDB's mark is itself a circle; the rest aren't). */
	.pz-oss-mark {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.75rem;
		transition: transform 0.18s ease;
	}
	.pz-oss-mark svg {
		height: 100%;
		width: auto;
		fill: var(--mark);
	}
	.pz-oss-mark--neutral svg {
		fill: var(--sl-color-gray-2);
	}
	/* DuckDB only — see the `badge` field's comment above. */
	.pz-oss-mark--badge {
		width: 2.75rem;
		border-radius: 50%;
	}
	.pz-oss-mark--badge svg {
		height: 62%;
		width: 62%;
	}

	.pz-oss-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}
	.pz-oss-info strong {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--sl-color-white);
	}
	.pz-oss-info span {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}

	@media (prefers-reduced-motion: reduce) {
		.pz-oss-mark {
			transition: none;
		}
	}
</style>
