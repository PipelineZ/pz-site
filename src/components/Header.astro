---
/**
 * Starlight's Header with the section nav (and its "Get Started" CTA) added to the right
 * group. GitHub is folded into TopNav itself rather than rendered separately here — the
 * default SocialIcons pill would just duplicate it — but SocialIcons still reaches readers
 * via MobileMenuFooter below 50rem, so it stays wired up in the Starlight config.
 *
 * Everything else is the upstream component verbatim, including the grid that aligns the
 * search box with the main content column — the nav sits in the third, auto-sized column
 * precisely so that alignment survives.
 */
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import TopNav from './TopNav.astro';
import { splitVersion } from '../versions';

/**
 * Render the `Search` component if Pagefind is enabled or the default search component has been overridden.
 */
const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

// A reader inside an archived version (/v0.4/…) gets that version's quickstart, like the
// section links in TopNav; the mobile "Get Started" in TopNav already behaves this way.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { version } = splitVersion(Astro.url.pathname.slice(base.length) || '/');
const quickstart = base + (version ? `/${version}` : '') + '/quickstart/';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="search-wrapper sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<TopNav variant="header" />
		<a class="get-started" href={quickstart}>
			Get Started
		</a>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	.header {
		display: flex;
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.title-wrapper {
		/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
		overflow: clip;
		/* Avoid clipping focus ring around link inside title wrapper. */
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	/* Collapse Starlight's search box down to just the magnifier icon —
	   drop the expanded border/background/placeholder-label look at every
	   breakpoint, including the desktop "wide box" variant. */
	.search-wrapper :global(button[data-open-modal]) {
		border: 0;
		background-color: transparent;
		padding: 0;
		width: auto;
		max-width: none;
	}
	.search-wrapper :global(button[data-open-modal] > span),
	.search-wrapper :global(button[data-open-modal] > kbd) {
		display: none;
	}
	/* The search column still spans all the free space between the title
	   and the right group (see the grid comment below) — push the icon to
	   the end of that space so it sits right before the "Docs" link
	   instead of stranded next to the title. */
	.search-wrapper {
		justify-content: flex-end;
	}

	/* Starlight's dialog reserves a 15rem min-height sized for its old
	   wide search box; drop it now that the trigger is icon-only so the
	   dialog hugs its actual content instead. */
	:global(site-search dialog) {
		min-height: unset;
	}

	.right-group {
		gap: 1rem;
		align-items: center;
	}
	/* The nav sets its own tighter rhythm; 1rem between two labels reads as two orphans. */
	.right-group {
		gap: 0.75rem;
	}

	.get-started {
		display: flex;
		align-items: center;
		padding: 0.4rem 0.85rem;
		border-radius: 0.5rem;
		background: var(--sl-color-accent);
		color: #0d0d0d;
		font-family: 'Bricolage Grotesque Variable', var(--sl-font-system);
		font-size: var(--sl-text-sm);
		font-weight: 700;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		transition: filter 150ms ease;
	}
	.get-started:hover {
		filter: brightness(1.1);
	}

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header {
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
      /* 1 (site title): runs up until the main content column’s left edge or the width of the title, whichever is the largest  */
				minmax(
					calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
					auto
				)
				/* 2 (search box): all free space that is available. */
				1fr
				/* 3 (right items): use the space that these need. */
				auto;
			align-content: center;
		}
	}
</style>
